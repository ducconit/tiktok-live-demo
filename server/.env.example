# TikTok Bar server config (Go)
# Copy to .env and fill in your values.

# Server port
PORT=3001

# Log directory (raw webcast events are written to <LOG_DIR>/webcast.log)
LOG_DIR=logs

# Connection mode: "long_poll" (default) hoặc "websocket"
CONNECTION_MODE=long_poll

# Long-poll interval (ms). Mặc định 3000 (3 giây).
POLL_INTERVAL_MS=3000

# Sockudo (Pusher-compatible WebSocket server) — khởi động bằng `docker compose up -d`
SOCKUDO_URL=http://localhost:6001
SOCKUDO_APP_ID=demo-app
SOCKUDO_APP_KEY=demo-key
SOCKUDO_APP_SECRET=demo-secret

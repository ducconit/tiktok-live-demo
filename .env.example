# ============================================================
# tiktok-live-platform — ENV CỦA DOCKER COMPOSE (optional, zero-config)
# Chỉ chứa biến cho docker compose: forward port + credentials của
# postgres/minio/valkey/mailpit/sockudo (substitute ${VAR} trong docker-compose.yml).
# Backend KHÔNG đọc file này — env backend nằm ở backend/.env
# (xem backend/.env.example — đầy đủ biến backend).
# Copy sang .env CHỈ KHI cần override: cp .env.example .env
# ============================================================

# ---- Tên container prefix ----
# APP_NAME=tiktok-live-platform

# ---- Postgres 18 (bắt buộc khớp với DSN backend) ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password_dev
POSTGRES_DB=tiktok_live_platform
# FORWARD_POSTGRES_PORT=5433

# ---- Valkey (Redis) ----
# VALKEY_PASSWORD=
# FORWARD_VALKEY_PORT=6380

# ---- MinIO ----
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin_dev
# FORWARD_MINIO_PORT=9010
# FORWARD_MINIO_CONSOLE_PORT=9011

# ---- Mailpit ----
# FORWARD_MAILPIT_PORT=8026
# FORWARD_MAILPIT_SMTP_PORT=1026

# ---- Sockudo (WebSocket server Pusher-compatible — live events) ----
# SOCKUDO_APP_ID=demo-app
# SOCKUDO_APP_KEY=demo-key
# SOCKUDO_APP_SECRET=demo-secret
# FORWARD_SOCKUDO_PORT=6002
# FORWARD_SOCKUDO_METRICS_PORT=9602

# ---- Port app/dashboard/frontend ----
# FORWARD_API_PORT=3330
# FORWARD_DASHBOARD_PORT=5176   # admin dashboard
# FORWARD_FRONTEND_PORT=5175    # end-user frontend (5174 đang bị dự án khác chiếm)

# ---- Monitoring (Prometheus/Grafana/Loki/OTel/Jaeger) ----
# FORWARD_PROMETHEUS_PORT=9092   # Prometheus UI (app metrics giữ 127.0.0.1:9090)
# FORWARD_GRAFANA_PORT=3006      # Grafana (admin/admin dev — GRAFANA_ADMIN_USER/PASSWORD)
# FORWARD_LOKI_PORT=3102
# FORWARD_OTEL_GRPC_PORT=4327    # OTLP gRPC
# FORWARD_OTEL_HTTP_PORT=4328    # OTLP HTTP
# FORWARD_JAEGER_UI_PORT=16687   # Jaeger UI (traces)

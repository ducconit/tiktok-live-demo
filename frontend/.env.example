# ============================================================
# tiktok-live-platform — ENV CỦA FRONTEND (end-user, optional)
# Đặt TRONG frontend/ (KHÔNG dùng env ở root — root chỉ cho docker/Makefile).
# Vite tự load .env từ thư mục frontend/ (VITE_ prefix → import.meta.env).
# Copy sang .env CHỈ KHI cần override: cp .env.example .env
# ============================================================

# ---- API backend cho vite proxy (/api) ----
# docker dev (compose): backend:3330 (qua docker network, tránh CORS)
# local dev (backend chạy ngoài container): http://localhost:3330
# VITE_API_BASE_URL=http://backend:3330

# ---- Sockudo (WebSocket Pusher-compatible — nhận events realtime) ----
# Host/port mà BROWSER kết nối (host port của container sockudo: 6002).
# VITE_SOCKUDO_HOST=localhost
# VITE_SOCKUDO_PORT=6002
# VITE_SOCKUDO_KEY=demo-key

# ============================================================
# tiktok-live-platform — ENV CỦA BACKEND (optional, zero-config)
# Đây là file backend sử dụng — đặt TRONG backend/, load từ CWD khi chạy:
#   cd backend && go run ./cmd/app
# Trong docker compose: backend/.env được mount vào container (/app/.env).
# Thứ tự ưu tiên: OS env (cao nhất) → CONFIG_DSN (config.yml/database) → .env → defaults.
# Copy sang .env CHỈ KHI cần override: cp .env.example .env
# ============================================================

# ---- Môi trường ----
# APP_ENV=development        # development | staging | production
# APP_NAME=tiktok-live-platform
# APP_TITLE=TikTok Live Platform
# LOG_LEVEL=info             # debug|info|warn|error — đổi runtime qua admin PUT /config

# ---- Server (mặc định 127.0.0.1:3330 — override qua --port / SERVER_PORT) ----
# SERVER_HOST=127.0.0.1
# SERVER_PORT=3330
# SERVER_RATE_LIMIT=100          # requests/giây per client (dynamic config)
# SERVER_RATE_LIMIT_STORE=       # "" = theo cache store; "memory" | "redis" (multi-instance)
# SERVER_AUTH_RATE_LIMIT=10      # auth group (login/OTP/forgot...) — chống brute force

# ---- Database (Postgres 18) ----
# DATABASE_URL=postgres://app:app_password_dev@localhost:5433/tiktok_live_platform?sslmode=disable
# DATABASE_REPLICAS=         # read replicas (comma-separated) — không set = read dùng master

# ---- Valkey (Redis) — dynamic config pub/sub + cache store ----
# REDIS_URL=redis://localhost:6380/0

# ---- Auth ----
# JWT_SECRET: default cố định "dev-secret-change-me" (chỉ dev).
# PRODUCTION bắt buộc: go run ./cmd/app key:generate (giống laravel artisan key:generate)
# JWT_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=720h

# ---- Seed admin (dev) — chạy: devtool seed ----
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=admin123

# ---- Cache (eko/gocache) — memory (Ristretto) mặc định, zero-config ----
# CACHE_STORE=memory          # memory | redis (multi-instance sau LB dùng redis)
# CACHE_PREFIX=
# CACHE_DEFAULT_TTL=5m

# ---- MinIO (avatar/upload) ----
# Storage — disk s3 (MINIO_* giữ tên env cũ → storage.disks.s3.*)
# MINIO_ENDPOINT=localhost:9010
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin_dev
# MINIO_BUCKET=tiktok-live-platform
# MINIO_USE_SSL=false
# STORAGE_DEFAULT_DISK=public

# ---- Mail (SMTP — dev dùng Mailpit) ----
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com
# MAIL_TLS_POLICY=auto     # auto (local→NoTLS, remote→STARTTLS) | none (Mailpit) | starttls

# ---- Logger (core/logger) ----
# LOG_FILE_ENABLED=true       # ghi thêm file theo ngày (logs/<app>-YYYY-MM-DD.log)
# LOG_FILE_DIR=logs
# LOG_FILE_KEEP_DAYS=14       # giữ N ngày, tự xoá file cũ

# ---- Prometheus metrics (PORT RIÊNG — xem docs/monitoring.md) ----
# METRICS_ENABLED=true        # bật listener metrics (mặc định)
# METRICS_HOST=127.0.0.1      # bind localhost; đổi 0.0.0.0 khi scrape từ xa
# METRICS_PORT=9090
# METRICS_PATH=/metrics
# METRICS_AUTH_TOKEN=         # "" = không auth; set = yêu cầu Bearer <token>

# ---- OpenTelemetry tracing (mặc định TẮT — xem core/otelx) ----
# OTEL_ENABLED=false          # bật khi có otel-collector (compose đã bật)
# OTEL_ENDPOINT=localhost:4327  # OTLP gRPC — compose: otel-collector:4317

# ---- OpenAPI spec tự động (mặc định BẬT — GET /api/v1/openapi.json) ----
# Tắt ở production nếu không muốn lộ spec: OPENAPI_ENABLED=false
# OPENAPI_ENABLED=true

# ---- Nguồn config chính (tuỳ chọn) ----
# CONFIG_DSN=file://config.yml   # YAML ở backend/ (mặc định) — xem config.example.yml
# CONFIG_DSN=postgres://app:app_password_dev@localhost:5433/tiktok_live_platform?sslmode=disable  # bảng app_config — bắt buộc có Redis

# ---- Live tracker (TikTok + Sockudo) ----
# CONNECTION_MODE=long_poll        # "long_poll" | "websocket"
# POLL_INTERVAL_MS=3000
# SOCKUDO_URL=http://localhost:6002
# SOCKUDO_APP_ID=demo-app
# SOCKUDO_APP_KEY=demo-key
# SOCKUDO_APP_SECRET=demo-secret
